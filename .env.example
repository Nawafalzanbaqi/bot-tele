# ---------------------------------------------------------------------------
# MediaHub configuration
#
# Every setting is read by `mediahub.shared.config.settings.Settings`.
# Nested settings use a double underscore: MEDIAHUB_<SECTION>__<FIELD>.
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
MEDIAHUB_ENVIRONMENT=local          # local | testing | staging | production
MEDIAHUB_DEBUG=true

# --- HTTP API --------------------------------------------------------------
MEDIAHUB_API__HOST=0.0.0.0
MEDIAHUB_API__PORT=8000
MEDIAHUB_API__ROOT_PATH=
MEDIAHUB_API__DOCS_ENABLED=true
MEDIAHUB_API__CORS_ORIGINS=["http://localhost:3000"]

# --- Persistence -----------------------------------------------------------
MEDIAHUB_DATABASE__BACKEND=postgres  # postgres | memory
MEDIAHUB_DATABASE__HOST=postgres
MEDIAHUB_DATABASE__PORT=5432
MEDIAHUB_DATABASE__USER=mediahub
MEDIAHUB_DATABASE__PASSWORD=change-me-in-production
MEDIAHUB_DATABASE__NAME=mediahub
MEDIAHUB_DATABASE__POOL_SIZE=10
MEDIAHUB_DATABASE__MAX_OVERFLOW=5
MEDIAHUB_DATABASE__ECHO=false

# --- Storage ---------------------------------------------------------------
# Deprecated: the product has no permanent library. Media is deleted once
# delivery is proven (ADR-0007); use the workspace below for scratch space.
MEDIAHUB_STORAGE__LIBRARY_PATH=/data/library
MEDIAHUB_STORAGE__STAGING_PATH=/data/staging
MEDIAHUB_STORAGE__MAX_ITEM_SIZE_BYTES=21474836480

# --- Workspace -------------------------------------------------------------
# Ephemeral, per-job scratch space. Put it on a different volume from the
# database where you can: the write-heavy, throwaway load then stays away from
# the card holding the only irreplaceable data.
MEDIAHUB_WORKSPACE__ROOT=/data/workspace
MEDIAHUB_WORKSPACE__MIN_FREE_BYTES=1073741824  # 1 GiB, never allocatable: it is
                                               # what leaves SQLite able to commit
                                               # the record of what went wrong
MEDIAHUB_WORKSPACE__MAX_LEASE_BYTES=8589934592   # 8 GiB per job
# MEDIAHUB_WORKSPACE__MAX_TOTAL_BYTES=          # unset = the device is the limit
MEDIAHUB_WORKSPACE__PURGE_ON_START=true          # wipe everything at startup.
                                                 # Set false when another process
                                                 # shares this root, or its live
                                                 # leases will be deleted.
MEDIAHUB_WORKSPACE__LEASE_EXPIRY_SECONDS=3600    # quiet period before another
                                                 # process's lease is swept
MEDIAHUB_WORKSPACE__ADOPT_OWN_LEASES_ON_START=false  # keep our own half-finished
                                                     # downloads across a restart

# --- Worker ----------------------------------------------------------------
# The process that executes queued jobs: python -m mediahub.presentation.worker
MEDIAHUB_WORKER__ENABLED=false
MEDIAHUB_WORKER__ROLE=worker         # part of the identity host:role:index
MEDIAHUB_WORKER__INDEX=0             # two workers on one host must differ here
MEDIAHUB_WORKER__SLOTS=1             # jobs executed at once; 1 suits a Pi 4
MEDIAHUB_WORKER__LEASE_SECONDS=120   # a crash is recovered within two of these
MEDIAHUB_WORKER__HEARTBEAT_SECONDS=30  # must be <= half the lease, and is also
                                       # the worst-case cancellation latency
MEDIAHUB_WORKER__IDLE_POLL_SECONDS=1
MEDIAHUB_WORKER__MAX_IDLE_POLL_SECONDS=5
MEDIAHUB_WORKER__DRAIN_GRACE_SECONDS=30  # keep below the orchestrator's kill timeout
MEDIAHUB_WORKER__PROGRESS_INTERVAL_SECONDS=5  # durable progress writes; low
MEDIAHUB_WORKER__PROGRESS_PERCENT_STEP=5      # values wear out an SD card

# --- Logging ---------------------------------------------------------------
MEDIAHUB_LOGGING__LEVEL=INFO         # TRACE | DEBUG | INFO | WARNING | ERROR
MEDIAHUB_LOGGING__JSON_FORMAT=false  # true in production (one JSON object per line)
MEDIAHUB_LOGGING__BACKTRACE=false
MEDIAHUB_LOGGING__DIAGNOSE=false     # never enable in production (leaks values)

# --- Security --------------------------------------------------------------
MEDIAHUB_SECURITY__SECRET_KEY=change-me-in-production

# --- Container entrypoint --------------------------------------------------
MEDIAHUB_RUN_MIGRATIONS=true
