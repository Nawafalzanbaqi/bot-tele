# ---------------------------------------------------------------------------
# MediaHub configuration
#
# Every setting is read by `mediahub.shared.config.settings.Settings`.
# Nested settings use a double underscore: MEDIAHUB_<SECTION>__<FIELD>.
# Copy this file to `.env` and adjust. Never commit the real `.env`.
#
# A typo here is a startup failure, not a silently ignored value: sections use
# `extra="forbid"`. That is deliberate - a misspelled ceiling that reverts to a
# default is far harder to notice than a process that refuses to boot.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
MEDIAHUB_ENVIRONMENT=local          # local | testing | staging | production
MEDIAHUB_DEBUG=true

# --- Telegram --------------------------------------------------------------
# The bot token from @BotFather. Never commit it; rotate it if it ever leaks.
MEDIAHUB_TELEGRAM__ENABLED=true
MEDIAHUB_TELEGRAM__BOT_TOKEN=

# Who may use the bot. Deny by default: an instance with all three lists empty
# allows nobody, which is the right posture for a bot whose username is
# guessable. Get your numeric id from @userinfobot.
#   owner    - everything
#   member   - may fetch, and read their own history
#   readonly - may look, may not fetch
MEDIAHUB_TELEGRAM__OWNER_IDS=["123456789"]
MEDIAHUB_TELEGRAM__MEMBER_IDS=[]
MEDIAHUB_TELEGRAM__READONLY_IDS=[]

MEDIAHUB_TELEGRAM__PROGRESS_INTERVAL_SECONDS=3   # Telegram tolerates ~1 edit/s
MEDIAHUB_TELEGRAM__HISTORY_LIMIT=10
MEDIAHUB_TELEGRAM__SESSION_TTL_SECONDS=900       # how long quality buttons last

# Self-hosted Bot API server. Unset, the upload ceiling is 50 MB; set, it is
# about 2 GB. Run the `localapi` compose profile to get one.
# MEDIAHUB_TELEGRAM__API_BASE_URL=http://botapi:8081

# Credentials for that server, from https://my.telegram.org (Apps). These
# identify the *application*, not the bot, and are not the bot token.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# --- Download engine -------------------------------------------------------
MEDIAHUB_DOWNLOAD__ENABLED=true
MEDIAHUB_DOWNLOAD__ALLOW_MERGE=true   # combine separate video+audio streams.
                                      # Needs FFmpeg (the image ships it).
                                      # Off, "1080p" quietly means 720p,
                                      # because above ~720p every large
                                      # platform ships the streams separately.
MEDIAHUB_DOWNLOAD__MAX_ITEM_BYTES=2147483648   # 2 GiB
MEDIAHUB_DOWNLOAD__PROBE_TIMEOUT_SECONDS=30
MEDIAHUB_DOWNLOAD__DOWNLOAD_TIMEOUT_SECONDS=3600
MEDIAHUB_DOWNLOAD__SOCKET_TIMEOUT_SECONDS=30   # what turns a stalled source
                                               # into a failure rather than a
                                               # hung worker
MEDIAHUB_DOWNLOAD__CONCURRENT_FRAGMENTS=1      # >1 rarely helps on a Pi
# MEDIAHUB_DOWNLOAD__RATE_LIMIT_BYTES_PER_SECOND=   # unset = no cap

# --- HTTP API --------------------------------------------------------------
MEDIAHUB_API__HOST=0.0.0.0
MEDIAHUB_API__PORT=8000
MEDIAHUB_API__ROOT_PATH=
MEDIAHUB_API__DOCS_ENABLED=true
# Origins allowed to call the API from a browser. Needed by the web interface;
# `["*"]` is not accepted with credentials, so name the real origin.
MEDIAHUB_API__CORS_ORIGINS=[]

# --- Persistence -----------------------------------------------------------
# sqlite is the system of record (ADR-0006): one file, no second process, and a
# transactional enqueue for free. postgres is supported for a deployment that
# already runs one; memory is for tests and is refused in production.
MEDIAHUB_DATABASE__BACKEND=sqlite
MEDIAHUB_DATABASE__SQLITE_PATH=/data/mediahub.db

# Only read when BACKEND=postgres.
# MEDIAHUB_DATABASE__HOST=postgres
# MEDIAHUB_DATABASE__PORT=5432
# MEDIAHUB_DATABASE__USER=mediahub
# MEDIAHUB_DATABASE__PASSWORD=change-me-in-production
# MEDIAHUB_DATABASE__NAME=mediahub

# --- Workspace -------------------------------------------------------------
# Ephemeral, per-job scratch space. Everything written here is deleted once the
# work that created it reaches a terminal state; whatever survives a crash is
# swept at startup. This is not a library - after delivery there is no local
# copy, by design (ADR-0007).
MEDIAHUB_WORKSPACE__ROOT=/data/workspace
MEDIAHUB_WORKSPACE__MIN_FREE_BYTES=1073741824  # 1 GiB, never allocatable: it is
                                               # what leaves SQLite able to
                                               # commit the record of what went
                                               # wrong
MEDIAHUB_WORKSPACE__MAX_LEASE_BYTES=8589934592   # 8 GiB per job
# MEDIAHUB_WORKSPACE__MAX_TOTAL_BYTES=          # unset = the device is the limit
MEDIAHUB_WORKSPACE__PURGE_ON_START=true          # wipe everything at startup.
                                                 # Set false when another
                                                 # process shares this root, or
                                                 # its live leases are deleted.
MEDIAHUB_WORKSPACE__LEASE_EXPIRY_SECONDS=3600
MEDIAHUB_WORKSPACE__ADOPT_OWN_LEASES_ON_START=false

# --- Delivery --------------------------------------------------------------
MEDIAHUB_DELIVERY__DEFAULT_PROVIDER=telegram
MEDIAHUB_DELIVERY__ENABLE_DUMMY=false   # a discard destination, for a dry run
MEDIAHUB_DELIVERY__FAILURE_THRESHOLD=3
MEDIAHUB_DELIVERY__COOLDOWN_SECONDS=60

# --- Worker ----------------------------------------------------------------
# The process that executes queued jobs. The Telegram gateway does *not* use
# it - it acquires directly - so leave this off unless the HTTP API is queueing
# work.
MEDIAHUB_WORKER__ENABLED=false
MEDIAHUB_WORKER__SLOTS=1             # 1 suits a Pi
MEDIAHUB_WORKER__LEASE_SECONDS=120   # a crash is recovered within two of these
MEDIAHUB_WORKER__HEARTBEAT_SECONDS=30  # must be <= half the lease, and is also
                                       # the worst-case cancellation latency

# --- Logging ---------------------------------------------------------------
MEDIAHUB_LOGGING__LEVEL=INFO         # TRACE | DEBUG | INFO | WARNING | ERROR
MEDIAHUB_LOGGING__JSON_FORMAT=false  # true where logs are shipped somewhere
MEDIAHUB_LOGGING__BACKTRACE=false
MEDIAHUB_LOGGING__DIAGNOSE=false     # never enable in production: it prints
                                     # the values of local variables, and one
                                     # of them is the bot token

# --- Security --------------------------------------------------------------
MEDIAHUB_SECURITY__SECRET_KEY=change-me-in-production
MEDIAHUB_SECURITY__BLOCK_PRIVATE_NETWORKS=true   # leave this on. Off, a
                                                 # submitted link can reach the
                                                 # router, the NAS and every
                                                 # other service on the LAN.

# --- Container entrypoint --------------------------------------------------
MEDIAHUB_RUN_MIGRATIONS=false   # SQLite creates its schema at startup
